<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_form_inherit_caja_chica" model="ir.ui.view">
        <field name="name">hr.expense.form.inherit.caja.chica</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="is_caja_chica_wallet" invisible="1"/>

                <group string="Caja Chica"
                       invisible="is_caja_chica_wallet">
                    <field name="x_studio_gasto_de_caja_chica"/>
                    <field name="x_studio_caja_chica"
                           invisible="not x_studio_gasto_de_caja_chica"/>
                </group>

                <group string="Control de Caja Chica"
                       invisible="not is_caja_chica_wallet">
                    <field name="saldo_original"/>
                    <field name="saldo_actual" readonly="1"/>
                </group>

                <group string="Gastos Asociados"
                       invisible="not is_caja_chica_wallet">
                    <field name="x_studio_gasto"
                           widget="many2many_tags"
                           readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_balance_caja_chica"
                        type="object"
                        string="Asociar Gasto"
                        class="btn-primary"
                        invisible="is_caja_chica_wallet or not x_studio_caja_chica or state != 'posted'"/>

                <button name="action_reajuste_caja_chica"
                        type="object"
                        string="Desasociar Gasto"
                        class="btn-secondary"
                        invisible="is_caja_chica_wallet or not x_studio_caja_chica or state != 'posted'"/>
            </xpath>

        </field>
    </record>
</odoo>